# Reference vhost for production.ozzyclothing.co.id (client).
#
# The server agent should merge these directives into the existing BT-panel
# vhost. Key goals:
#   1. Never cache HTML/RSC/API responses (the global proxy.conf proxy_cache
#      must NOT apply to this site's dynamic responses).
#   2. Serve /_next/static straight from the append-only shared dir so old
#      HTML keeps resolving its chunks across deploys.
#   3. Expose diagnostic headers for deploy verification.

# Written atomically by scripts/deploy.sh:
include /root/produksi/nginx/ozzy-client-upstream.conf;

server {
    listen 443 ssl;
    server_name production.ozzyclothing.co.id;
    # ... existing TLS cert/config stays as-is ...

    # Diagnostics: which upstream/cache layer answered.
    add_header X-Upstream $upstream_addr always;
    add_header X-Cache-Status $upstream_cache_status always;

    # Immutable, content-hashed assets: serve from the shared static dir.
    # Falls back to the Node upstream if a file is missing locally.
    location ^~ /_next/static/ {
        alias /root/produksi/shared/client/_next/static/;
        access_log off;
        expires max;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri @ozzy_client;
    }

    # Everything else: no proxy caching at any level.
    location / {
        proxy_pass http://ozzy_client;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Defeat the global proxy.conf cache for this site.
        proxy_cache off;
        proxy_buffering off;

        # Belt-and-suspenders on top of the app's own no-store headers.
        add_header Cache-Control "private, no-cache, no-store, must-revalidate" always;
    }

    location @ozzy_client {
        proxy_pass http://ozzy_client;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
    }
}
