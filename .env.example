NEXT_PUBLIC_ENCRYPTION_KEY=example-key-secret
NEXT_PUBLIC_BE_BASE_URL=http://example.com
APP_BUILD_VERSION=0.1.0

# Bump this string on every deploy to force-clear all clients' localStorage on next load.
# Forces re-login because tokens live in localStorage. Recommended values: semver, ISO date, or commit SHA.
NEXT_PUBLIC_APP_VERSION=dev
